rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function authed() {
      return request.auth != null;
    }
    function uid() {
      return request.auth.uid;
    }
    function singleClassId() {
      return 'main';
    }
    function projectDoc(projectId) {
      return get(/databases/$(database)/documents/projects/$(projectId)).data;
    }
    function classDoc() {
      return get(/databases/$(database)/documents/classes/$(singleClassId())).data;
    }
    function votingOn() {
      return classDoc().votingEnabled == true;
    }
    function discussionOn() {
      return classDoc().discussionEnabled == true;
    }

    match /students/{studentId} {
      allow read: if authed();
      allow create, update: if authed() && uid() == studentId;
      allow delete: if false;
    }

    match /classes/{classId} {
      allow read: if authed();
      allow create, update: if authed() && classId == singleClassId();
      allow delete: if false;

      match /members/{memberId} {
        allow read: if authed();
        allow create: if authed() && uid() == memberId && classId == singleClassId();
        allow update: if authed() && (uid() == memberId || classId == singleClassId());
        allow delete: if false;
      }
    }

    match /activities/{activityId} {
      allow read: if authed();
      allow create: if authed()
        && request.resource.data.userId == uid()
        && request.resource.data.classId == singleClassId();
      allow update, delete: if false;
    }

    match /userVotes/{userId} {
      allow read: if authed();
      allow create, update: if authed()
        && uid() == userId
        && request.resource.data.classId == singleClassId();
      allow delete: if authed() && uid() == userId;
    }

    match /projects/{projectId} {
      allow read: if authed() && (
        resource.data.ownerId == uid() ||
        resource.data.classId == singleClassId()
      );
      allow create: if authed()
        && request.resource.data.ownerId == uid()
        && request.resource.data.classId == singleClassId();
      allow update: if authed() && resource.data.ownerId == uid();
      allow delete: if authed() && (
        resource.data.ownerId == uid() ||
        resource.data.classId == singleClassId()
      );

      match /versions/{versionId} {
        allow read: if authed() && projectDoc(projectId).ownerId == uid();
        allow create: if authed() && projectDoc(projectId).ownerId == uid();
        allow update: if false;
        allow delete: if authed() && (
          projectDoc(projectId).ownerId == uid() ||
          projectDoc(projectId).classId == singleClassId()
        );
      }
    }

    match /publicProjects/{projectId} {
      allow get: if true;
      allow list: if authed() && resource.data.classId == singleClassId();
      allow create: if authed()
        && projectDoc(projectId).ownerId == uid()
        && request.resource.data.classId == singleClassId();
      allow update: if authed() && resource.data.classId == singleClassId() && (
        (projectDoc(projectId).ownerId == uid()) ||
        (votingOn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['voteCount']))
      );
      allow delete: if authed() && (
        projectDoc(projectId).ownerId == uid() ||
        resource.data.classId == singleClassId()
      );

      match /comments/{commentId} {
        allow read: if true;
        allow create: if authed()
          && discussionOn()
          && request.resource.data.userId == uid()
          && request.resource.data.classId == singleClassId()
          && request.resource.data.projectId == projectId;
        allow delete: if authed() && (
          resource.data.userId == uid() ||
          resource.data.classId == singleClassId()
        );
        allow update: if false;
      }
    }
  }
}
